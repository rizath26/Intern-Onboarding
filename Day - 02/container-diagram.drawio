<mxfile host="app.diagrams.net"><diagram id="bookswap-c4-l2" name="Container diagram"><mxGraphModel dx="2000" dy="1130" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;BookSwap — Container diagram (C4 Level 2)&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="700" height="40" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;BookSwap system&lt;/b&gt; [Azure]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 6;strokeColor=#555555;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=16;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="45.0" y="417.5" width="1910.0" height="640.0" as="geometry"/></mxCell><mxCell id="member" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Member&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px;color:#DDE8F5&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:15px&#x27;&gt;Neighbour who lends and borrows books&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80.0" y="92.5" width="330" height="165" as="geometry"/></mxCell><mxCell id="member_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="211" y="52.5" width="68" height="68" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Microsoft Entra External ID&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px;color:#DDE8F5&#x27;&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:15px&#x27;&gt;Signs members in; issues JWTs&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor