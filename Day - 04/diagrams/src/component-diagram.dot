digraph "component-diagram" {
graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.9, pad=0.4, splines=true, bgcolor="white", labelloc=t, fontsize=18, label=<<B>GreenChit — Component diagram for the Claims API (C4 Level 3)</B>>];
node [fontname="DejaVu Sans", style="filled,rounded", margin="0.18,0.12", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=9, color="#555555", fontcolor="#333333", arrowsize=0.8];
"web" [shape=box, style="filled,rounded", fillcolor="#1168BD", color="#0B4884", label=<<FONT COLOR="#FFFFFF"><B>Web App</B><BR/><FONT POINT-SIZE="9">[Container: React SPA, TypeScript,<BR/>MSAL.js]</FONT><BR/><BR/><FONT POINT-SIZE="10">Browser UI for all roles.</FONT></FONT>>];
"db" [shape=cylinder, style="filled", fillcolor="#1168BD", color="#0B4884", label=<<FONT COLOR="#FFFFFF"><B>Claims Database</B><BR/><FONT POINT-SIZE="9">[Container: Azure SQL Database]</FONT><BR/><BR/><FONT POINT-SIZE="10">Claims, audit ledger, outbox.</FONT></FONT>>];
"blob" [shape=cylinder, style="filled", fillcolor="#1168BD", color="#0B4884", label=<<FONT COLOR="#FFFFFF"><B>Receipt Store</B><BR/><FONT POINT-SIZE="9">[Container: Azure Blob Storage]</FONT><BR/><BR/><FONT POINT-SIZE="10">Receipt images.</FONT></FONT>>];
"sb" [shape=box, style="filled,rounded", fillcolor="#1168BD", color="#0B4884", label=<<FONT COLOR="#FFFFFF"><B>Event Queue</B><BR/><FONT POINT-SIZE="9">[Container: Azure Service Bus]</FONT><BR/><BR/><FONT POINT-SIZE="10">claim-events queue.</FONT></FONT>>];
"kv" [shape=box, style="filled,rounded", fillcolor="#1168BD", color="#0B4884", label=<<FONT COLOR="#FFFFFF"><B>Key Vault</B><BR/><FONT POINT-SIZE="9">[Container: Azure Key Vault]</FONT><BR/><BR/><FONT POINT-SIZE="10">Webhook URL secret.</FONT></FONT>>];
"entra" [shape=box, style="filled,rounded", fillcolor="#8C8C8C", color="#6B6B6B", label=<<FONT COLOR="#FFFFFF"><B>Microsoft Entra ID</B><BR/><FONT POINT-SIZE="9">[External system]</FONT><BR/><BR/><FONT POINT-SIZE="10">Token signing keys, users,<BR/>managers.</FONT></FONT>>];
"teams" [shape=box, style="filled,rounded", fillcolor="#8C8C8C", color="#6B6B6B", label=<<FONT COLOR="#FFFFFF"><B>Teams Workflows</B><BR/><FONT POINT-SIZE="9">[External system]</FONT><BR/><BR/><FONT POINT-SIZE="10">Adaptive Card to manager.</FONT></FONT>>];
"exo" [shape=box, style="filled,rounded", fillcolor="#8C8C8C", color="#6B6B6B", label=<<FONT COLOR="#FFFFFF"><B>Exchange Online</B><BR/><FONT POINT-SIZE="9">[External system]</FONT><BR/><BR/><FONT POINT-SIZE="10">Fallback email.</FONT></FONT>>];
"spo" [shape=box, style="filled,rounded", fillcolor="#8C8C8C", color="#6B6B6B", label=<<FONT COLOR="#FFFFFF"><B>SharePoint Online</B><BR/><FONT POINT-SIZE="9">[External system]</FONT><BR/><BR/><FONT POINT-SIZE="10">Payroll export folder.</FONT></FONT>>];
subgraph "cluster_api" { label=<<B>Claims API</B><BR/><FONT POINT-SIZE="9">[Container: ASP.NET Core (.NET 10) on Azure App Service]</FONT>>; labeljust=l; fontsize=12; style="dashed,rounded"; color="#444444"; fontcolor="#444444";
"auth" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Auth &amp; Access Policy</B><BR/><FONT POINT-SIZE="9">[Component: ASP.NET Core middleware,<BR/>Microsoft.Identity.Web]</FONT><BR/><BR/><FONT POINT-SIZE="10">Validates Entra JWTs, maps app<BR/>roles, and allows a claim to be<BR/>seen only by its claimant,<BR/>approver, Finance or Auditor.</FONT></FONT>>];
"claims" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Claims Module</B><BR/><FONT POINT-SIZE="9">[Component: Controllers + domain service]</FONT><BR/><BR/><FONT POINT-SIZE="10">Create/edit drafts, submit,<BR/>approve, reject, request info,<BR/>mark paid. Owns the claim state<BR/>machine.</FONT></FONT>>];
"rcpt" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Receipts Module</B><BR/><FONT POINT-SIZE="9">[Component: Controllers +<BR/>Azure.Storage.Blobs]</FONT><BR/><BR/><FONT POINT-SIZE="10">Enforces 5 files × 10 MB, issues<BR/>per-blob SAS, verifies uploads are<BR/>committed and scanned clean.</FONT></FONT>>];
"export" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Payroll Export Module</B><BR/><FONT POINT-SIZE="9">[Component: Controller + CsvHelper]</FONT><BR/><BR/><FONT POINT-SIZE="10">Builds the CSV of Approved claims<BR/>as an export batch and uploads it.<BR/>Marks a batch Paid on Finance<BR/>confirmation.</FONT></FONT>>];
"dir" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Directory Client</B><BR/><FONT POINT-SIZE="9">[Component: Microsoft Graph SDK]</FONT><BR/><BR/><FONT POINT-SIZE="10">Looks up the claimant&#x27;s line<BR/>manager when a claim is created.</FONT></FONT>>];
"audit" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Audit Writer</B><BR/><FONT POINT-SIZE="9">[Component: Domain service]</FONT><BR/><BR/><FONT POINT-SIZE="10">Appends who / when / from→to /<BR/>reason for every state transition,<BR/>inside the same DB transaction.</FONT></FONT>>];
"data" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Data Access</B><BR/><FONT POINT-SIZE="9">[Component: EF Core 10 DbContext]</FONT><BR/><BR/><FONT POINT-SIZE="10">Persistence and transactions for<BR/>claims, receipts, audit, outbox.</FONT></FONT>>];
"outbox" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Outbox Publisher</B><BR/><FONT POINT-SIZE="9">[Component: BackgroundService]</FONT><BR/><BR/><FONT POINT-SIZE="10">Moves committed outbox rows to the<BR/>Event Queue, so no event is lost<BR/>if the API crashes after commit.</FONT></FONT>>];
"notify" [shape=box, style="filled,rounded", fillcolor="#85BBF0", color="#5D82A8", label=<<FONT COLOR="#000000"><B>Notification Dispatcher</B><BR/><FONT POINT-SIZE="9">[Component: BackgroundService,<BR/>ServiceBusProcessor]</FONT><BR/><BR/><FONT POINT-SIZE="10">Sends Teams card; falls back to<BR/>email after 3 failed attempts.<BR/>Idempotent on eventId.</FONT></FONT>>];
}
"web" -> "auth" [label=<Sends every request through<BR/><FONT POINT-SIZE="8">[HTTPS/JSON, Bearer JWT]</FONT>>, style="solid"];
"auth" -> "entra" [label=<Fetches token signing keys<BR/>from<BR/><FONT POINT-SIZE="8">[HTTPS, OIDC discovery]</FONT>>, style="solid"];
"auth" -> "claims" [label=<Forwards authorised claim<BR/>calls to<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"auth" -> "rcpt" [label=<Forwards authorised receipt<BR/>calls to<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"auth" -> "export" [label=<Forwards Finance-only calls to<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"claims" -> "rcpt" [label=<Checks receipts complete and<BR/>clean via<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"claims" -> "dir" [label=<Resolves approver using<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"claims" -> "audit" [label=<Records transitions with<BR/><FONT POINT-SIZE="8">[in-process, same transaction]</FONT>>, style="solid"];
"export" -> "audit" [label=<Records Paid transitions with<BR/><FONT POINT-SIZE="8">[in-process, same transaction]</FONT>>, style="solid"];
"claims" -> "data" [label=<Saves claims and outbox events<BR/>through<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"export" -> "data" [label=<Queries Approved claims<BR/>through<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"rcpt" -> "data" [label=<Saves receipt metadata through<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"audit" -> "data" [label=<Appends ledger rows through<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"outbox" -> "data" [label=<Reads unsent events through<BR/><FONT POINT-SIZE="8">[in-process]</FONT>>, style="solid"];
"data" -> "db" [label=<Reads from and writes to<BR/><FONT POINT-SIZE="8">[TDS over TLS, managed identity]</FONT>>, style="solid"];
"rcpt" -> "blob" [label=<Issues SAS for and reads<BR/>properties/tags from<BR/><FONT POINT-SIZE="8">[HTTPS, managed identity]</FONT>>, style="solid"];
"dir" -> "entra" [label=<Reads user&#x27;s manager from<BR/><FONT POINT-SIZE="8">[HTTPS, Microsoft Graph]</FONT>>, style="solid"];
"export" -> "spo" [label=<Uploads CSV to<BR/><FONT POINT-SIZE="8">[HTTPS, Microsoft Graph]</FONT>>, style="solid"];
"outbox" -> "sb" [label=<Publishes claim events to<BR/><FONT POINT-SIZE="8">[AMQP over TLS]</FONT>>, style="solid"];
"sb" -> "notify" [label=<Delivers claim events to<BR/><FONT POINT-SIZE="8">[AMQP over TLS, peek-lock]</FONT>>, style="solid"];
"notify" -> "kv" [label=<Reads webhook URL from<BR/><FONT POINT-SIZE="8">[HTTPS, managed identity]</FONT>>, style="solid"];
"notify" -> "teams" [label=<Posts Adaptive Card to<BR/><FONT POINT-SIZE="8">[HTTPS webhook]</FONT>>, style="solid"];
"notify" -> "exo" [label=<Sends fallback email via<BR/><FONT POINT-SIZE="8">[HTTPS, Microsoft Graph sendMail]</FONT>>, style="solid"];
legend [shape=plaintext, style="", label=<<TABLE BORDER="1" COLOR="#999999" CELLBORDER="0" CELLSPACING="4" CELLPADDING="4"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legend</B></TD></TR><TR><TD BGCOLOR="#08427B" WIDTH="28"> </TD><TD ALIGN="LEFT">Person</TD></TR><TR><TD BGCOLOR="#1168BD"> </TD><TD ALIGN="LEFT">Container (cylinder = data store)</TD></TR><TR><TD BGCOLOR="#85BBF0"> </TD><TD ALIGN="LEFT">Component</TD></TR><TR><TD BGCOLOR="#8C8C8C"> </TD><TD ALIGN="LEFT">External system (not built by us)</TD></TR><TR><TD ALIGN="LEFT">- - -</TD><TD ALIGN="LEFT">Boundary</TD></TR><TR><TD ALIGN="LEFT">→</TD><TD ALIGN="LEFT">Verb-led relationship [protocol]</TD></TR></TABLE>>];
}