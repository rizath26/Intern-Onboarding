<mxfile host="generated"><diagram id="component-diagram" name="GreenChit — Component diagram for the Claims API (C4 Level 3)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2740" pageHeight="1458" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_api" value="&lt;b&gt;Claims API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: ASP.NET Core (.NET 10) on Azure App Service]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#444444;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="373" y="374" width="1600" height="870" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: React SPA, TypeScript, MSAL.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Browser UI for all roles.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="752" y="122" width="226" height="93" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;Auth &amp; Access Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: ASP.NET Core middleware, Microsoft.Identity.Web]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Validates Entra JWTs, maps app roles, and allows a claim to be seen only by its claimant, approver, Finance or Auditor.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="736" y="420" width="259" height="130" as="geometry"/></mxCell><mxCell id="claims" value="&lt;b&gt;Claims Module&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: Controllers + domain service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Create/edit drafts, submit, approve, reject, request info, mark paid. Owns the claim state machine.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="602" y="665" width="277" height="119" as="geometry"/></mxCell><mxCell id="rcpt" value="&lt;b&gt;Receipts Module&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: Controllers + Azure.Storage.Blobs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Enforces 5 files × 10 MB, issues per-blob SAS, verifies uploads are committed and scanned clean.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1421" y="899" width="240" height="118" as="geometry"/></mxCell><mxCell id="export" value="&lt;b&gt;Payroll Export Module&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: Controller + CsvHelper]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Builds the CSV of Approved claims as an export batch and uploads it. Marks a batch Paid on Finance confirmation.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="919" y="665" width="248" height="119" as="geometry"/></mxCell><mxCell id="dir" value="&lt;b&gt;Directory Client&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: Microsoft Graph SDK]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Looks up the claimant&#x27;s line manager when a claim is created.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="383" y="911" width="240" height="94" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit Writer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: Domain service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Appends who / when / from→to / reason for every state transition, inside the same DB transaction.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="926" y="904" width="234" height="106" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Data Access&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: EF Core 10 DbContext]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Persistence and transactions for claims, receipts, audit, outbox.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="1140" width="241" height="94" as="geometry"/></mxCell><mxCell id="outbox" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: BackgroundService]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Moves committed outbox rows to the Event Queue, so no event is lost if the API crashes after commit.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1701" y="904" width="263" height="106" as="geometry"/></mxCell><mxCell id="notify" value="&lt;b&gt;Notification Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Component: BackgroundService, ServiceBusProcessor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sends Teams card; falls back to email after 3 failed attempts. Idempotent on eventId.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="426" width="260" height="118" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Claims Database&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure SQL Database]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Claims, audit ledger, outbox.&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1131" y="1347" width="219" height="112" as="geometry"/></mxCell><mxCell id="blob" value="&lt;b&gt;Receipt Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Blob Storage]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Receipt images.&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1983" y="1131" width="212" height="112" as="geometry"/></mxCell><mxCell id="sb" value="&lt;b&gt;Event Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Service Bus]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;claim-events queue.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2236" y="1147" width="206" height="81" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Key Vault]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Webhook URL secret.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2069" y="684" width="191" height="81" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Token signing keys, users, managers.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="1140" width="211" height="94" as="geometry"/></mxCell><mxCell id="teams" value="&lt;b&gt;Teams Workflows&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Adaptive Card to manager.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2301" y="684" width="202" height="81" as="geometry"/></mxCell><mxCell id="exo" value="&lt;b&gt;Exchange Online&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Fallback email.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2544" y="684" width="196" height="81" as="geometry"/></mxCell><mxCell id="spo" value="&lt;b&gt;SharePoint Online&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Payroll export folder.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="133" y="917" width="210" height="81" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;table&gt;&lt;tr&gt;&lt;td style=&#x27;background:#08427B;width:24px&#x27;&gt;&lt;/td&gt;&lt;td&gt;Person&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;background:#1168BD;width:24px&#x27;&gt;&lt;/td&gt;&lt;td&gt;Container (cylinder = data store)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;background:#85BBF0;width:24px&#x27;&gt;&lt;/td&gt;&lt;td&gt;Component&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;background:#8C8C8C;width:24px&#x27;&gt;&lt;/td&gt;&lt;td&gt;External system (not built by us)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;- - -&lt;/td&gt;&lt;td&gt;Boundary&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&amp;#8594;&lt;/td&gt;&lt;td&gt;Verb-led relationship [protocol]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=#999999;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1083" y="93" width="260" height="150" as="geometry"/></mxCell><mxCell id="e0" value="Sends every request through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS/JSON, Bearer JWT]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Fetches token signing keys from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, OIDC discovery]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Forwards authorised claim calls to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="claims"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Forwards authorised receipt calls to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="rcpt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Forwards Finance-only calls to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="export"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Checks receipts complete and clean via&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="claims" target="rcpt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Resolves approver using&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="claims" target="dir"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Records transitions with&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process, same transaction]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="claims" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Records Paid transitions with&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process, same transaction]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="export" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Saves claims and outbox events through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="claims" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Queries Approved claims through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="export" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Saves receipt metadata through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="rcpt" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Appends ledger rows through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="audit" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Reads unsent events through&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[in-process]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="outbox" target="data"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Reads from and writes to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[TDS over TLS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="data" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Issues SAS for and reads properties/tags from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="rcpt" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="Reads user&#x27;s manager from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Microsoft Graph]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="dir" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="Uploads CSV to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Microsoft Graph]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="export" target="spo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="Publishes claim events to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[AMQP over TLS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="outbox" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="Delivers claim events to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[AMQP over TLS, peek-lock]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="sb" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="Reads webhook URL from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="notify" target="kv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="Posts Adaptive Card to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS webhook]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="notify" target="teams"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="Sends fallback email via&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Microsoft Graph sendMail]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="notify" target="exo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>