<mxfile host="generated"><diagram id="container-diagram" name="GreenChit — Container diagram (C4 Level 2)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2793" pageHeight="1375" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_gc" value="&lt;b&gt;GreenChit&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Software System]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#444444;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=8;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="631" y="385" width="1478" height="980" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b&gt;Staff member&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Submits reimbursement claims with receipts and tracks their status.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="577" y="121" width="255" height="94" as="geometry"/></mxCell><mxCell id="mgr" value="&lt;b&gt;Line manager&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Approves, rejects or asks for more information on a direct report&#x27;s claim.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2121" y="115" width="244" height="106" as="geometry"/></mxCell><mxCell id="fin" value="&lt;b&gt;Finance officer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Exports approved claims for payroll and marks batches as paid.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="963" y="121" width="248" height="94" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Auditor&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Reviews the audit trail of any claim (read-only).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1251" y="121" width="214" height="94" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: React SPA, TypeScript, MSAL.js — runs in the browser]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Mobile-friendly UI for all four roles. Uploads receipts straight to the Receipt Store in resumable blocks.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1104" y="431" width="238" height="130" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Claims API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: ASP.NET Core (.NET 10) on Azure App Service, Linux P0v3 × 2]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Serves the Web App files and the REST API. Enforces the claim state machine and access rules. Runs background outbox publisher, notification dispatcher and export.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1097" y="675" width="251" height="155" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Claims Database&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure SQL Database, General Purpose, 2 vCore]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Claims, receipt metadata, outbox and notification log. Audit log in an append-only ledger table.&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1538" y="945" width="265" height="162" as="geometry"/></mxCell><mxCell id="blob" value="&lt;b&gt;Receipt Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Blob Storage, private container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Receipt images. Reachable only with short-lived user-delegation SAS URLs.&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1843" y="945" width="255" height="162" as="geometry"/></mxCell><mxCell id="sb" value="&lt;b&gt;Event Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Service Bus Standard, queue: claim-events]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Buffers claim events for notification delivery, with retry and dead-lettering.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="641" y="967" width="261" height="118" as="geometry"/></mxCell><mxCell id="digest" value="&lt;b&gt;Ledger Digest Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Blob Storage with immutability policy]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Holds database ledger digests so audit tampering can be detected.&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1552" y="1210" width="236" height="144" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Key Vault]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Holds the Teams Workflows webhook URL (the URL itself is a secret).&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="943" y="979" width="260" height="94" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Container: Azure Monitor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Request traces, dependency timings (p95 submit), alerts on dead-letters.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1243" y="973" width="255" height="106" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;BISTEC tenant. Single sign-on, app roles (Finance, Auditor) and manager relationships.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="378" y="699" width="244" height="106" as="geometry"/></mxCell><mxCell id="teams" value="&lt;b&gt;Teams Workflows&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Power Automate workflow behind a webhook. Posts the Adaptive Card to the manager&#x27;s Teams chat.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C