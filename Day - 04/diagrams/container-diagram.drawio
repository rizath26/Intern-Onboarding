ndArrow=block;endFill=1;" edge="1" parent="1" source="fin" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Reads audit trail using&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="aud" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Signs users in via&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[OIDC auth code + PKCE, HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Calls&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS/JSON, Bearer JWT]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Uploads receipt blocks to / reads receipts from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, user-delegation SAS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Reads and writes claims, audit, outbox in&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[TDS over TLS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Issues SAS for and checks receipts in&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Publishes and consumes claim events on&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[AMQP over TLS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Reads webhook URL from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, managed identity]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="kv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Validates tokens and looks up managers in&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, OIDC metadata + Microsoft Graph]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Posts approval card to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS webhook, Adaptive Card JSON]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="teams"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Sends fallback email via&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Microsoft Graph sendMail]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="exo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Uploads payroll CSV to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Microsoft Graph (Sites.Selected)]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="spo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Sends telemetry to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, OpenTelemetry]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="ai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="Writes ledger digests to&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[HTTPS, Azure-managed]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="db" target="digest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="Scans new blobs and tags results in&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[Azure-internal]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="def" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="Notifies&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[Teams chat (Flow bot)]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="teams" target="mgr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="Emails (fallback)&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[SMTP / Outlook]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="exo" target="mgr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="Picks up CSV from&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;[SharePoint folder trigger]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#555555;fontColor=#333333;endArrow=block;endFill=1;" edge="1" parent="1" source="payroll" target="spo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>